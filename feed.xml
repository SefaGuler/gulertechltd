---
layout: null
permalink: /feed.xml
---
{% assign all = "" | split: "" %}{% for key in site.category_order %}{% assign all = all | concat: site[key] %}{% endfor %}{% assign items = all | sort: "date" | reverse | slice: 0, 30 %}<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ site.title | xml_escape }}</title>
  <description>{{ site.description | xml_escape }}</description>
  <link>{{ site.url }}/</link>
  <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
  <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
  {% for n in items %}
  <item>
    <title>{{ n.title | xml_escape }}</title>
    <description>{{ n.summary | default: n.excerpt | strip_html | xml_escape }}</description>
    <pubDate>{{ n.date | date_to_rfc822 }}</pubDate>
    <link>{{ n.url | absolute_url }}</link>
    <guid isPermaLink="true">{{ n.url | absolute_url }}</guid>
    {% for t in n.tags %}<category>{{ t | xml_escape }}</category>{% endfor %}
  </item>
  {% endfor %}
</channel>
</rss>
